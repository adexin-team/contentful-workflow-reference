# Exact fictional target attestations. Replace every profile-bound value together.
CONTENTFUL_AI_PREVIEW_CDA_ATTESTATION={"apiRoot":"https://cdn.contentful.com/spaces/demoSpace123/environments/preview-sandbox","environmentId":"preview-sandbox","host":"cdn.contentful.com","spaceId":"demoSpace123"}
CONTENTFUL_AI_PREVIEW_CMA_ATTESTATION={"apiRoot":"https://api.contentful.com/spaces/demoSpace123/environments/preview-sandbox","environmentId":"preview-sandbox","host":"api.contentful.com","spaceId":"demoSpace123"}
CONTENTFUL_AI_PREVIEW_CPA_ATTESTATION={"apiRoot":"https://preview.contentful.com/spaces/demoSpace123/environments/preview-sandbox","environmentId":"preview-sandbox","host":"preview.contentful.com","spaceId":"demoSpace123"}
CONTENTFUL_PRODUCTION_CDA_ATTESTATION={"apiRoot":"https://cdn.contentful.com/spaces/demoSpace123/environments/live-sandbox","environmentId":"live-sandbox","host":"cdn.contentful.com","spaceId":"demoSpace123"}
CONTENTFUL_PRODUCTION_CMA_ATTESTATION={"apiRoot":"https://api.contentful.com/spaces/demoSpace123/environments/live-sandbox","environmentId":"live-sandbox","host":"api.contentful.com","spaceId":"demoSpace123"}

# Separate least-privilege tokens. Never place real values in a committed file.
CONTENTFUL_AI_PREVIEW_CDA_TOKEN=replace-with-disposable-read-only-delivery-token
CONTENTFUL_AI_PREVIEW_CMA_TOKEN=replace-with-preview-environment-management-token
CONTENTFUL_AI_PREVIEW_CPA_TOKEN=replace-with-disposable-preview-delivery-token
CONTENTFUL_PRODUCTION_CDA_TOKEN=replace-with-read-only-production-delivery-token
CONTENTFUL_PRODUCTION_CMA_READ_TOKEN=replace-with-read-only-production-management-token
# Set only for a freshly confirmed execute command; preparation never reads it.
CONTENTFUL_PRODUCTION_CMA_WRITE_TOKEN=replace-with-write-capable-production-management-token-after-confirmation
CONTENTFUL_AI_PREVIEW_GATSBY_REFRESH_TOKEN=replace-with-one-time-local-refresh-token

# Reconstruct these from exact checked-out commits and canonical workflow artifacts.
CONTENTFUL_AI_PREVIEW_BASELINE_GENERATION_DIGEST=replace-with-64-lowercase-hex-baseline-digest
CONTENTFUL_AI_PREVIEW_CHANGESET_DIGEST=replace-with-64-lowercase-hex-changeset-digest
CONTENTFUL_AI_PREVIEW_WORKFLOW_COMMIT=replace-with-40-lowercase-hex-reviewed-workflow-commit
CONTENTFUL_AI_PREVIEW_GATSBY_COMMIT=replace-with-40-lowercase-hex-reviewed-gatsby-commit
CONTENTFUL_WORKFLOW_EXECUTION_COMMIT=replace-with-40-lowercase-hex-current-execution-commit

# Optional bounded local-review timeout.
CONTENTFUL_AI_PREVIEW_GATSBY_REVIEW_TIMEOUT_MS=600000
